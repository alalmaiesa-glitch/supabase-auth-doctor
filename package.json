{
  "name": "supabase-auth-doctor",
  "version": "0.1.0",
  "description": "A tiny CLI that diagnoses Supabase Auth + OAuth + Vercel configuration mistakes.",
  "type": "module",
  "bin": {
    "supabase-auth-doctor": "./bin/supabase-auth-doctor.js"
  },
  "scripts": {
    "doctor": "node ./bin/supabase-auth-doctor.js",
    "test": "node --test",
    "check": "node --check ./bin/supabase-auth-doctor.js && node --check ./src/index.js && npm test"
  },
  "keywords": [
    "supabase",
    "auth",
    "oauth",
    "vercel",
    "diagnostics",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alalmaiesa-glitch/supabase-auth-doctor.git"
  },
  "homepage": "https://github.com/alalmaiesa-glitch/supabase-auth-doctor#readme",
  "bugs": {
    "url": "https://github.com/alalmaiesa-glitch/supabase-auth-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
